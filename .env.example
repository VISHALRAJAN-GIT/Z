# Copy to .env and fill in. Never commit .env.
# Phase 00 uses no secrets; this file exists so the pattern is established
# before the first credential is needed.

# ---- Paths ----
TVF_DATA_ROOT=data
TVF_CONFIG_ROOT=configs
TVF_CHECKPOINT_ROOT=checkpoints
TVF_ARTIFACT_ROOT=artifacts

# ---- Audio canonical format (GUIDE section 11) ----
TVF_SAMPLE_RATE=16000
TVF_CHANNELS=1

# ---- Compute ----
# auto | cpu | cuda
TVF_DEVICE=auto
TVF_NUM_THREADS=4

# ---- Reproducibility ----
TVF_SEED=1337

# ---- Dataset (dataset_v001 and later; see docs/02_data/licensing.md) ----
TVF_DATASET_VERSION=dataset_v001

# ---- Logging ----
TVF_LOG_LEVEL=INFO